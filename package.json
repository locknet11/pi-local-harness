{
  "name": "pi-local-llm-harness",
  "version": "1.0.0",
  "description": "Build whole projects from scratch with the pi coding agent driven by local LLMs (Ollama / LM Studio)",
  "keywords": ["pi", "coding-agent", "ollama", "lmstudio", "local-llm", "agentic", "harness"],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "pi-harness": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "templates",
    "README.md"
  ],
  "scripts": {
    "compile": "tsc -p tsconfig.json",
    "prepare": "node scripts/prepare.mjs",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
